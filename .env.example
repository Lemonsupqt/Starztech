# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# MegaLLM API Configuration
MEGALLM_API_KEY=your_megallm_api_key_here
MEGALLM_API_URL=https://api.megallm.io/v1/chat/completions

# Bot Settings
# Recommended: deepseek-chat or qwen-max (unlimited usage on max plan)
# Other options: gpt-4, gpt-3.5-turbo, claude-3-opus, claude-3-sonnet, gemini-pro
DEFAULT_MODEL=deepseek-chat
MAX_TOKENS=2000
TEMPERATURE=0.7
